{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "lib": ["ES2020", "DOM"],
    "jsx": "react-jsx",
    "types": ["jest", "node"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/__tests__", "example", "dist", "node_modules"]
}
